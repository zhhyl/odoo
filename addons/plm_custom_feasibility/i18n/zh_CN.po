#. module: plm_custom_feasibility
#: model:mail.template,body_html:plm_custom_feasibility.mail_template_plm_feasibility_decided
msgid "<div style=\"margin: 0px; padding: 0px;\">\n    <p style=\"margin: 0 0 12px 0; font-size: 13px;\">\n        你好，\n        <br/><br/>\n        可行性評估 <strong t-out=\"object.name or ''\">FEA/2026/00001</strong> 已做出結論：\n        <strong t-out=\"dict(object._fields['state'].selection).get(object.state) or ''\">state</strong>\n        （決策：\n        <strong t-out=\"dict(object._fields['decision'].selection).get(object.decision) or ''\">decision</strong>）。\n        <br/><br/>\n        客戶：<t t-out=\"object.partner_id.display_name or ''\">客戶</t>\n        <br/>\n        產品：<t t-out=\"object.product_id.display_name or ''\">產品</t>\n        <br/>\n        總分：<t t-out=\"object.score_total or 0\">總分</t>\n    </p>\n</div>\n        "
msgstr ""

#. module: plm_custom_feasibility
#: model:mail.template,body_html:plm_custom_feasibility.mail_template_plm_feasibility_submit
msgid "<div style=\"margin: 0px; padding: 0px;\">\n    <p style=\"margin: 0 0 12px 0; font-size: 13px;\">\n        你好，\n        <br/><br/>\n        業務 <t t-out=\"object.user_id.display_name or ''\">負責業務</t> 已送出可行性評估\n        <strong t-out=\"object.name or ''\">FEA/2026/00001</strong>。\n        <br/>\n        客戶：<t t-out=\"object.partner_id.display_name or ''\">客戶</t>\n        <br/>\n        產品：<t t-out=\"object.product_id.display_name or ''\">產品</t>\n        <br/>\n        數量：<t t-out=\"object.product_qty or 0\">數量</t>\n        <br/>\n        客戶要求交期：<t t-out=\"object.requested_date or ''\">交期</t>\n        <br/><br/>\n        請至系統填寫您所屬部門的評分與意見。\n    </p>\n</div>\n        "
msgstr ""

