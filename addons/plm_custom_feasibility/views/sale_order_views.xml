<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 在 SO Form 的 button_box 新增「可行性評估」smart button -->
    <record id="sale_order_view_form_inherit_feasibility" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.plm.custom.feasibility</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div class="oe_button_box" name="button_box" position="inside">
                <button name="action_view_feasibility"
                        type="object"
                        class="oe_stat_button"
                        icon="check_circle"
                        invisible="feasibility_count == 0">
                    <field name="feasibility_count" widget="statinfo" string="可行性評估"/>
                </button>
            </div>
        </field>
    </record>

    <!-- 在 SO Form 的 header 新增「建立可行性評估」按鈕 -->
    <record id="sale_order_view_form_inherit_feasibility_create" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.plm.custom.feasibility.create</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_open_feasibility_wizard"
                        string="建立可行性評估"
                        type="object"
                        class="btn-secondary"
                        invisible="feasibility_count > 0"/>
            </header>
        </field>
    </record>

</odoo>
