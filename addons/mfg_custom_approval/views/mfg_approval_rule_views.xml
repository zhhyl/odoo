<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Rule: Search View -->
    <record id="mfg_approval_rule_view_search" model="ir.ui.view">
        <field name="name">mfg_custom.approval.rule.view.search</field>
        <field name="model">mfg_custom.approval.rule</field>
        <field name="arch" type="xml">
            <search string="搜尋簽核規則">
                <field name="name"/>
                <field name="model_id"/>
                <field name="company_id"/>
                <separator/>
                <filter name="active" string="啟用中" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="已停用" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_res_model" string="依業務模型" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Rule: List View -->
    <record id="mfg_approval_rule_view_tree" model="ir.ui.view">
        <field name="name">mfg_custom.approval.rule.view.tree</field>
        <field name="model">mfg_custom.approval.rule</field>
        <field name="arch" type="xml">
            <list string="MFG Custom 簽核規則">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="model_display" optional="hide"/>
                <field name="domain" optional="hide"/>
                <field name="step_ids" widget="many2many_tags" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Rule: Form View -->
    <record id="mfg_approval_rule_view_form" model="ir.ui.view">
        <field name="name">mfg_custom.approval.rule.view.form</field>
        <field name="model">mfg_custom.approval.rule</field>
        <field name="arch" type="xml">
            <form string="MFG Custom 簽核規則">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="已停用" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="例：採購單金額 > 100 萬"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"
                                   placeholder="選擇要簽核的單據類型"/>
                            <field name="model_display" readonly="1"/>
                            <field name="res_model" invisible="1"/>
                            <field name="model_name" invisible="1"/>
                            <field name="sequence"/>
                            <field name="due_days"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="domain" widget="domain"
                                   options="{'model': 'model_name', 'in_dialog': True}"
                                   placeholder="留空 = 所有此類單據都適用"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="簽核關卡" name="steps">
                            <field name="step_ids" widget="one2many" mode="list,form">
                                <list string="簽核關卡" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="approver_mode" widget="selection"/>
                                    <field name="user_ids" widget="many2many_tags" optional="show"
                                           invisible="approver_mode != 'user'"/>
                                    <field name="group_id" optional="show"
                                           invisible="approver_mode not in ('group', 'group_all')"/>
                                    <field name="approver_field_id" optional="show"
                                           domain="[('model', '=', parent.res_model), ('relation', '=', 'res.users')]"
                                           invisible="approver_mode != 'field'"/>
                                    <field name="department_id" optional="show"
                                           invisible="approver_mode not in ('department', 'department_manager')"/>
                                    <field name="preview_approver_info" optional="hide"/>
                                    <field name="min_amount" optional="hide"/>
                                    <field name="max_amount" optional="hide"/>
                                    <field name="amount_field_id" optional="hide"
                                           domain="[('model', '=', parent.res_model), ('ttype', 'in', ('float', 'monetary'))]"/>
                                    <field name="amount_currency_id" optional="hide"/>
                                    <field name="required"/>
                                </list>
                                <form string="簽核關卡">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="sequence"/>
                                                <field name="name"/>
                                                <field name="approver_mode" widget="selection"/>
                                                <field name="required"/>
                                            </group>
                                        </group>
                                        <group>
                                            <group string="簽核者">
                                                <field name="user_ids" widget="many2many_tags"
                                                       invisible="approver_mode != 'user'"/>
                                                <field name="group_id"
                                                       invisible="approver_mode not in ('group', 'group_all')"/>
                                                <field name="approver_field_id"
                                                       domain="[('model', '=', parent.res_model), ('relation', '=', 'res.users')]"
                                                       invisible="approver_mode != 'field'"
                                                       help="選擇單據上指向使用者（res.users）的欄位。"/>
                                                <field name="department_id"
                                                       invisible="approver_mode not in ('department', 'department_manager')"/>
                                            </group>
                                            <group string="金額門檻">
                                                <field name="min_amount"/>
                                                <field name="max_amount"/>
                                                <field name="amount_field_id"
                                                       domain="[('model', '=', parent.res_model), ('ttype', 'in', ('float', 'monetary'))]"/>
                                                <field name="amount_currency_id"/>
                                            </group>
                                        </group>
                                        <group string="簽核者預覽">
                                            <field name="preview_approver_info" nolabel="1"
                                                   placeholder="選擇簽核者設定後，這裡會顯示解析結果與員工狀態"/>
                                        </group>
                                        <group>
                                            <field name="note" placeholder="備註"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="說明" name="note">
                            <field name="note" placeholder="規則用途說明"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Rule: Action -->
    <record id="mfg_approval_rule_action" model="ir.actions.act_window">
        <field name="name">MFG Custom 簽核規則</field>
        <field name="res_model">mfg_custom.approval.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mfg_approval_rule_view_search"/>
        <field name="help">為不同業務模型（PLM ECO、銷售訂單、生產工單等）建立對應的多層簽核規則。</field>
    </record>

</odoo>
