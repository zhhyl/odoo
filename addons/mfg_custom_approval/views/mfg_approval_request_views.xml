<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Request: Search View -->
    <record id="mfg_approval_request_view_search" model="ir.ui.view">
        <field name="name">mfg_custom.approval.request.view.search</field>
        <field name="model">mfg_custom.approval.request</field>
        <field name="arch" type="xml">
            <search string="搜尋簽核申請">
                <field name="name"/>
                <field name="rule_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="res_display_name" string="業務單據"/>
                <field name="requester_id"/>
                <field name="due_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter name="pending" string="待簽核" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="已核准" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="被駁回" domain="[('state', '=', 'rejected')]"/>
                <filter name="cancelled" string="已取消" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="mine" string="我提出的" domain="[('requester_id', '=', uid)]"/>
                <filter name="my_decision" string="我待簽" domain="[('line_ids.user_id', '=', uid), ('line_ids.decision', '=', 'pending')]"/>
                <separator/>
                <filter name="overdue" string="逾期未簽" domain="[('state', '=', 'pending'), ('due_date', '&lt;', context_today())]"/>
                <group>
                    <filter name="group_rule" string="依規則" context="{'group_by': 'rule_id'}"/>
                    <filter name="group_res_model" string="依業務模型" context="{'group_by': 'res_model'}"/>
                    <filter name="group_state" string="依狀態" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Request: List View -->
    <record id="mfg_approval_request_view_tree" model="ir.ui.view">
        <field name="name">mfg_custom.approval.request.view.tree</field>
        <field name="model">mfg_custom.approval.request</field>
        <field name="arch" type="xml">
            <!-- create="0"：簽核單是由業務單據送出簽核時自動建立的，不開放手動新增。
                 手動新增會得到一張沒有 rule_id / res_model / res_id 的空殼單據。 -->
            <list string="MFG Custom 簽核申請" create="0"
                  decoration-danger="state == 'rejected' or is_overdue"
                  decoration-success="state == 'approved'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="rule_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="res_display_name" string="業務單據"/>
                <field name="current_step_no"/>
                <field name="current_step_id"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'rejected'"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'pending'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="requester_id"/>
                <field name="submit_date"/>
                <field name="due_date" optional="show"/>
                <field name="is_overdue" column_invisible="True"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Request: Form View -->
    <record id="mfg_approval_request_view_form" model="ir.ui.view">
        <field name="name">mfg_custom.approval.request.view.form</field>
        <field name="model">mfg_custom.approval.request</field>
        <field name="arch" type="xml">
            <form string="MFG Custom 簽核申請">
                <header>
                    <button name="action_approve" string="核准目前關卡" type="object"
                            class="btn-primary"
                            invisible="state != 'pending' or current_step_id == False"/>
                    <button name="action_reject" string="駁回" type="object"
                            class="btn-danger"
                            invisible="state != 'pending' or current_step_id == False"
                            confirm="確定要駁回此簽核申請？"/>
                    <button name="action_cancel" string="取消簽核" type="object"
                            invisible="state not in ('draft', 'pending')"/>
                    <button name="action_reset_to_draft" string="重置為草稿" type="object"
                            groups="mfg_custom_base.group_manager"
                            invisible="state not in ('cancelled', 'rejected')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,approved"
                           readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_res_record" type="object"
                                class="oe_stat_button" icon="fa-external-link"
                                string="開啟單據"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="rule_id" readonly="1"/>
                            <field name="current_step_no" string="目前關卡"/>
                            <field name="current_step_id" string="目前關卡名稱"/>
                        </group>
                        <group>
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="requester_id" readonly="1"/>
                            <field name="submit_date" readonly="1"/>
                            <field name="due_date"/>
                            <field name="is_overdue" invisible="not is_overdue"
                                   widget="badge" decoration-danger="True"
                                   string="已逾期"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" placeholder="若被駁回，請先在此填寫原因再按駁回"
                               readonly="state != 'pending'"/>
                        <field name="pending_approver_emails" readonly="1"
                               invisible="not pending_approver_emails"/>
                    </group>
                    <notebook>
                        <page string="簽核紀錄" name="lines">
                            <field name="line_ids" readonly="1">
                                <list string="簽核紀錄"
                                      decoration-success="decision == 'approved'"
                                      decoration-danger="decision == 'rejected'"
                                      decoration-muted="decision in ('pending', 'skipped')">
                                    <field name="step_id"/>
                                    <field name="user_id"/>
                                    <field name="decision" widget="badge"
                                           decoration-success="decision == 'approved'"
                                           decoration-danger="decision == 'rejected'"
                                           decoration-muted="decision == 'skipped'"
                                           decoration-warning="decision == 'pending'"/>
                                    <field name="decision_date"/>
                                    <field name="approver_department_id" optional="hide"/>
                                    <field name="approver_employee_state" optional="hide"/>
                                    <field name="comment" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Request: Action -->
    <record id="mfg_approval_request_action" model="ir.actions.act_window">
        <field name="name">MFG Custom 簽核申請</field>
        <field name="res_model">mfg_custom.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mfg_approval_request_view_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">目前沒有待簽核的簽核申請。</p>
            <p>
                簽核單是由<strong>業務單據送出簽核</strong>時自動產生的，這裡是彙總檢視，
                不需要（也不能）手動新增。
            </p>
            <p>兩種常見情境：</p>
            <ul>
                <li>
                    要讓某張單據（例如採購單 PO）可以送審：
                    請到 <strong>MFG Custom > 設定 > 簽核規則</strong>
                    建立一條規則，「適用單據類型」選該單據類型。
                </li>
                <li>
                    要送出簽核：請開啟該筆業務單據，按右上角的
                    <strong>「送出簽核」</strong>按鈕。
                    送審後這裡就會出現紀錄，也會出現在「待我簽核」。
                </li>
            </ul>
        </field>
    </record>

    <!-- Request: My Decision action (僅顯示當前使用者為潛在簽核者的申請) -->
    <record id="mfg_approval_request_action_my_decision" model="ir.actions.act_window">
        <field name="name">待我簽核</field>
        <field name="res_model">mfg_custom.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mfg_approval_request_view_search"/>
        <field name="context">{'search_default_my_decision': 1, 'search_default_pending': 1}</field>
        <field name="domain">[('state', '=', 'pending')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">目前沒有待您簽核的申請。</p>
            <p>
                待簽核的申請會出現在這裡。簽核單是由業務單據送出簽核時自動產生的，
                請到該業務單據按「送出簽核」開始流程。
            </p>
        </field>
    </record>

</odoo>
