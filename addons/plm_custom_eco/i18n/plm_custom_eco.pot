#. module: plm_custom_eco
#: model:ir.module.module,description:base.module_plm_custom_eco
msgid ""
"\n"
"PLM Custom - Engineering Change Order\n"
"=====================================\n"
"\n"
"完整的工程變更單 (ECO/ECN) 系統（取代 Enterprise ``plm``）：\n"
"\n"
"* 申請 → 影響分析 → 待簽核 → 核准/駁回 → 套用 → 取消\n"
"* 自動影響分析（展開未完成 SO / 庫存 / 未關 MO / 相關附件）\n"
"* 觸發來源：客戶/內部/供應商/問題点/法規\n"
"* 套用時自動：\n"
"    - 凍結舊 BOM 快照\n"
"    - 升版 BOM version\n"
"    - 升版附件版本（透過 mfg_custom_attachment_version）\n"
"* 可從問題点升級\n"
"* 多層簽核（透過 mfg_custom_approval）\n"
msgstr ""

#. module: plm_custom_eco
#: model:mail.template,body_html:plm_custom_eco.mail_template_plm_eco_apply
msgid ""
"<p>ECO <t t-out=\"object.name\"/> 已套用。</p>\n"
"<ul>\n"
"    <li>主旨：<t t-out=\"object.subject\"/></li>\n"
"    <li>產品：<t t-out=\"object.product_id.display_name\"/></li>\n"
"    <li>BOM 版本：<t t-out=\"object.from_version\"/> → <t t-out=\"object.to_version\"/></li>\n"
"    <li>影響清單：<t t-out=\"len(object.line_ids)\"/> 筆</li>\n"
"</ul>\n"
"        "
msgstr ""

