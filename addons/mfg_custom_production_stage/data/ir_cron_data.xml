<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">

    <!-- 每日 23:00 重算所有 done MO 的得料率 -->
    <record model="ir.cron" forcecreate="True" id="cron_recompute_mfg_custom_yield_rate">
        <field name="name">MFG Custom: 重算得料率</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="state">code</field>
        <field name="code">model._cron_recompute_mfg_custom_yield_rate()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=23, minute=0, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

</data></odoo>
