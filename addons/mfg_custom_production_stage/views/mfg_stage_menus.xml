<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- MO 群組 by production_stage 的 action（先定義） -->
    <record id="mrp_production_action_group_by_stage" model="ir.actions.act_window">
        <field name="name">生產階段分析</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form,kanban,calendar,activity</field>
        <field name="context">{'group_by': ['mfg_custom_production_stage', 'state']}</field>
        <field name="help">依「生產階段」分組的製造工單分析。樣品單獨立評估，小批量觀察良率，量產追蹤穩定度。</field>
    </record>

    <!-- 良率分析 action：含 pivot 與 graph；預設篩選 state=done -->
    <record id="mrp_production_action_yield_analysis" model="ir.actions.act_window">
        <field name="name">良率分析</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="context">{'search_default_filter_done': 1}</field>
        <field name="help">跨 MO 的得料率走勢：依「生產階段 × 月份」分析良率（pivot）+ 月度良率走勢（graph）。</field>
    </record>

    <!--
        階段變更日誌的 action 定義於 views/mrp_production_views.xml
        （mrp_production_stage_log_action，帶 search_view_id），
        此處不再重複定義，避免後載入的記錄覆蓋前者。
    -->

    <!-- MFG Custom 子選單：生產階段 -->
    <!-- groups 與 mrp 內建選單一致（mrp.group_mrp_user），避免一般 MFG 使用者開啟後 AccessError -->
    <menuitem id="menu_mfg_custom_stage_root"
              name="生產階段"
              parent="mfg_custom_base.menu_mfg_custom_root"
              sequence="20"
              groups="mrp.group_mrp_user"/>

    <menuitem id="menu_mfg_custom_stage_analysis"
              name="生產階段分析"
              parent="menu_mfg_custom_stage_root"
              sequence="10"
              action="mrp_production_action_group_by_stage"
              groups="mrp.group_mrp_user"/>

    <menuitem id="menu_mfg_custom_stage_yield_analysis"
              name="良率分析"
              parent="menu_mfg_custom_stage_root"
              sequence="15"
              action="mrp_production_action_yield_analysis"
              groups="mrp.group_mrp_user"/>

    <menuitem id="menu_mfg_custom_stage_log"
              name="階段變更日誌"
              parent="menu_mfg_custom_stage_root"
              sequence="20"
              action="mfg_custom_production_stage.mrp_production_stage_log_action"
              groups="mrp.group_mrp_user"/>

</odoo>
