<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tag: List View -->
    <record id="mfg_custom_tag_view_tree" model="ir.ui.view">
        <field name="name">mfg_custom.tag.view.tree</field>
        <field name="model">mfg_custom.tag</field>
        <field name="arch" type="xml">
            <list string="MFG Custom 標籤">
                <field name="name"/>
                <field name="color" widget="color"/>
                <field name="description"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Tag: Form View -->
    <record id="mfg_custom_tag_view_form" model="ir.ui.view">
        <field name="name">mfg_custom.tag.view.form</field>
        <field name="model">mfg_custom.tag</field>
        <field name="arch" type="xml">
            <form string="MFG Custom 標籤">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="已停用" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color"/>
                        <field name="description"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tag: Search View -->
    <record id="mfg_custom_tag_view_search" model="ir.ui.view">
        <field name="name">mfg_custom.tag.view.search</field>
        <field name="model">mfg_custom.tag</field>
        <field name="arch" type="xml">
            <search string="搜尋 MFG Custom 標籤">
                <field name="name"/>
                <field name="description"/>
                <filter name="inactive" string="已停用" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Tag: Action -->
    <record id="mfg_custom_tag_action" model="ir.actions.act_window">
        <field name="name">MFG Custom 標籤</field>
        <field name="res_model">mfg_custom.tag</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mfg_custom_tag_view_search"/>
        <field name="help">MFG Custom 模組群共用的標籤字典。</field>
    </record>

</odoo>
