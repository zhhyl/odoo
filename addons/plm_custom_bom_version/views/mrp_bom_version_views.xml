<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ List View ============ -->
    <record id="mrp_bom_version_view_tree" model="ir.ui.view">
        <field name="name">mrp.bom.version.view.list</field>
        <field name="model">mrp.bom.version</field>
        <field name="arch" type="xml">
            <list string="BOM 版本快照">
                <field name="name"/>
                <field name="version"/>
                <field name="bom_id"/>
                <field name="reason"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="snapshot_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ============ Form View ============ -->
    <record id="mrp_bom_version_view_form" model="ir.ui.view">
        <field name="name">mrp.bom.version.view.form</field>
        <field name="model">mrp.bom.version</field>
        <field name="arch" type="xml">
            <form string="BOM 版本快照" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="已鎖定" bg_color="text-bg-success"/>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="version" readonly="1"/>
                            <field name="bom_id" readonly="1"/>
                            <field name="reason" readonly="1" widget="badge"/>
                            <field name="eco_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="snapshot_date" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="product_qty" readonly="1"/>
                            <field name="product_uom_id" readonly="1" groups="uom.group_uom"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="元件明細" name="lines">
                            <field name="line_ids" readonly="1">
                                <list string="元件明細" create="0" edit="0" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id" groups="uom.group_uom" widget="many2one_uom"/>
                                    <field name="product_cost"/>
                                </list>
                            </field>
                        </page>
                        <page string="工序" name="operations"
                              groups="mrp.group_mrp_routings">
                            <field name="operation_ids" readonly="1">
                                <list string="工序" create="0" edit="0" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="workcenter_id"/>
                                    <field name="time_cycle" string="工時（分）"/>
                                    <field name="cost"/>
                                </list>
                            </field>
                        </page>
                        <page string="副產品" name="byproducts"
                              groups="mrp.group_mrp_byproducts">
                            <field name="byproduct_ids" readonly="1">
                                <list string="副產品" create="0" edit="0" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id" groups="uom.group_uom" widget="many2one_uom"/>
                                </list>
                            </field>
                        </page>
                        <page string="備註" name="note">
                            <field name="note" readonly="1" placeholder="建立當下的說明"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============ Search View ============ -->
    <record id="mrp_bom_version_view_search" model="ir.ui.view">
        <field name="name">mrp.bom.version.view.search</field>
        <field name="model">mrp.bom.version</field>
        <field name="arch" type="xml">
            <search string="搜尋 BOM 版本快照">
                <field name="name"/>
                <field name="version"/>
                <field name="bom_id"/>
                <field name="user_id"/>
                <separator/>
                <filter name="reason_eco" string="ECO 觸發"
                        domain="[('reason', '=', 'eco')]"/>
                <filter name="reason_manual" string="手動建立"
                        domain="[('reason', '=', 'manual')]"/>
                <filter name="reason_milestone" string="里程碑"
                        domain="[('reason', '=', 'milestone')]"/>
                <separator/>
                <filter name="snapshot_date" string="本月"
                        domain="[('snapshot_date','>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group>
                    <filter name="group_bom" string="BOM" context="{'group_by': 'bom_id'}"/>
                    <filter name="group_reason" string="原因" context="{'group_by': 'reason'}"/>
                    <filter name="group_user" string="建立者" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ Action ============ -->
    <record id="mrp_bom_version_action" model="ir.actions.act_window">
        <field name="name">BOM 版本快照</field>
        <field name="res_model">mrp.bom.version</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mrp_bom_version_view_search"/>
        <field name="help">記錄每一張 BOM 的歷史快照，所有快照為 immutable。</field>
    </record>

</odoo>
