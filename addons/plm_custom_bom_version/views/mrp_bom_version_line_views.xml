<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 獨立的快照明細 List View（從 mrp.bom.version form 內嵌清單另外拉出，方便
         從 BOM 端呼叫查看元件歷史）。 -->
    <record id="mrp_bom_version_line_view_tree" model="ir.ui.view">
        <field name="name">mrp.bom.version.line.view.list</field>
        <field name="model">mrp.bom.version.line</field>
        <field name="arch" type="xml">
            <list string="BOM 快照明細" create="0" edit="0" delete="0">
                <field name="version_id"/>
                <field name="sequence" widget="handle"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="product_uom_id" groups="uom.group_uom" widget="many2one_uom"/>
                <field name="product_cost"/>
            </list>
        </field>
    </record>

    <record id="mrp_bom_version_line_view_search" model="ir.ui.view">
        <field name="name">mrp.bom.version.line.view.search</field>
        <field name="model">mrp.bom.version.line</field>
        <field name="arch" type="xml">
            <search string="搜尋 BOM 快照明細">
                <field name="product_id"/>
                <field name="version_id"/>
                <group>
                    <filter name="group_version" string="快照" context="{'group_by': 'version_id'}"/>
                    <filter name="group_product" string="元件" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mrp_bom_version_line" model="ir.actions.act_window">
        <field name="name">BOM 快照明細</field>
        <field name="res_model">mrp.bom.version.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mrp_bom_version_line_view_search"/>
        <field name="help">每一筆 BOM 快照明細（immutable）。</field>
    </record>

</odoo>
