<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mfg_quote_cost_wizard_view_form" model="ir.ui.view">
        <field name="name">mfg_custom.quote.cost.wizard.view.form</field>
        <field name="model">mfg_custom.quote.cost.wizard</field>
        <field name="arch" type="xml">
            <form string="報價 BOM 成本展開">
                <group>
                    <field name="sale_order_id" readonly="1" force_save="1"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list string="要展開的明細" editable="bottom">
                        <field name="include" widget="boolean_toggle"/>
                        <field name="sale_order_line_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_explode" string="展開成本"
                            type="object" class="btn-primary"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
