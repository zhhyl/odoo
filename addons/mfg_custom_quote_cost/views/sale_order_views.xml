<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form_inherit_mfg_quote_cost" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.mfg.custom.quote.cost</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_quote_cost_wizard"
                        string="展開成本"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calculator"
                        groups="mfg_custom_base.group_user"
                        invisible="state == 'cancel'"/>
            </div>
        </field>
    </record>

    <record id="sale_order_view_list_inherit_mfg_quote_cost" model="ir.ui.view">
        <field name="name">sale.order.view.list.inherit.mfg.custom.quote.cost</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="amount_total" position="before">
                <field name="mfg_custom_quote_cost_total" optional="hide" sum="Total Quote Cost"/>
            </field>
        </field>
    </record>

</odoo>
