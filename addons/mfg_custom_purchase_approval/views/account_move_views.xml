<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =============================================================== -->
    <!--  廠商帳單：PO 審批未通過的警示                                  -->
    <!--  正常情況下 invisible（不影響既有帳單畫面）                    -->
    <!-- =============================================================== -->
    <record id="mfg_account_move_view_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.mfg_approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- 以 sheet 內 button_box 的 name 為錨點（依 name 屬性定位） -->
            <xpath expr="//sheet/div[@name='button_box']" position="before">
                <div class="alert alert-danger" role="alert"
                     invisible="not mfg_approval_blocked">
                    <strong>此帳單的採購單尚未通過審批，無法付款。</strong>
                    <div class="mt-1">
                        <field name="mfg_approval_blocked_message" nolabel="1" readonly="1"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
