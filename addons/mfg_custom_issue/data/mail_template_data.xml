<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <!-- 不使用 noupdate：通知信的收件人設定（use_default_to / email_to）
         需要在模組升級時一併更新，否則既有資料庫仍會沿用舊設定 -->
    <record id="mail_template_mfg_issue_open" model="mail.template">
        <field name="name">問題点開立通知</field>
        <field name="model_id" ref="model_mfg_custom_issue"/>
        <field name="subject">{{ object.name }} {{ object.subject }}</field>
        <field name="body_html"><![CDATA[
<p>問題点 <t t-out="object.name"/> 已開立。</p>
<ul>
    <li>主旨：<t t-out="object.subject"/></li>
    <li>負責人：<t t-out="object.user_id.name"/></li>
    <li>MO：<t t-out="object.production_id.name or ''"/></li>
</ul>
        ]]></field>
        <!-- 收件人由 template 指定（問題点負責人），不採用預設追隨者 -->
        <field name="use_default_to" eval="False"/>
        <field name="email_to">{{ object.user_id.email }}</field>
    </record>
</data></odoo>
