<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">

    <record id="stage_open" model="mfg_custom.issue.stage">
        <field name="name">開立</field>
        <field name="sequence">10</field>
        <field name="fold">False</field>
        <field name="is_closed">False</field>
    </record>

    <record id="stage_analyzing" model="mfg_custom.issue.stage">
        <field name="name">分析中</field>
        <field name="sequence">20</field>
        <field name="fold">False</field>
        <field name="is_closed">False</field>
    </record>

    <record id="stage_containment" model="mfg_custom.issue.stage">
        <field name="name">圍堵中</field>
        <field name="sequence">30</field>
        <field name="fold">False</field>
        <field name="is_closed">False</field>
    </record>

    <record id="stage_implementing" model="mfg_custom.issue.stage">
        <field name="name">永久對策執行中</field>
        <field name="sequence">40</field>
        <field name="fold">True</field>
        <field name="is_closed">False</field>
    </record>

    <record id="stage_verifying" model="mfg_custom.issue.stage">
        <field name="name">驗證中</field>
        <field name="sequence">50</field>
        <field name="fold">True</field>
        <field name="is_closed">False</field>
    </record>

    <record id="stage_closed" model="mfg_custom.issue.stage">
        <field name="name">已結案</field>
        <field name="sequence">60</field>
        <field name="fold">True</field>
        <field name="is_closed">True</field>
    </record>

</data></odoo>
