<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_task_view_form_inherit_mfg_issue" model="ir.ui.view">
        <field name="name">project.task.view.form.inherit.mfg.custom.issue</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="mfg_custom_issue_id"
                       domain="[('task_id', '=', False), ('state', '!=', 'closed')]"
                       groups="mfg_custom_base.group_user"
                       optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
