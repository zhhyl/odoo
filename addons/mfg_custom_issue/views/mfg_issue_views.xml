<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mfg_issue_view_tree" model="ir.ui.view">
        <field name="name">mfg_custom.issue.view.tree</field>
        <field name="model">mfg_custom.issue</field>
        <field name="arch" type="xml">
            <list string="問題点" decoration-danger="priority == '3'" decoration-warning="priority == '2'">
                <field name="name"/>
                <field name="subject"/>
                <field name="issue_type"/>
                <field name="priority" widget="priority"/>
                <field name="stage_id" optional="show"/>
                <field name="state" optional="show"/>
                <field name="approval_state" widget="badge" optional="show"
                       decoration-info="approval_state == 'pending'"
                       decoration-success="approval_state == 'approved'"
                       decoration-danger="approval_state == 'rejected'"/>
                <field name="production_id" optional="hide"/>
                <field name="product_id" optional="show"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="create_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mfg_issue_view_form" model="ir.ui.view">
        <field name="name">mfg_custom.issue.view.form</field>
        <field name="model">mfg_custom.issue</field>
        <field name="arch" type="xml">
            <form string="問題点">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="open,analyzing,implementing,closed"/>
                    <button name="action_submit_for_approval" string="送出簽核" type="object"
                            class="btn-primary"
                            invisible="state == 'closed' or approval_state == 'pending'"/>
                    <button name="action_approve_current_step" string="核准目前關卡" type="object"
                            class="btn-primary"
                            invisible="approval_state != 'pending'"/>
                    <button name="action_reject_current_step" string="駁回" type="object"
                            class="btn-danger"
                            invisible="approval_state != 'pending'"
                            confirm="確定要駁回此簽核流程？"/>
                    <button name="action_cancel_approval" string="取消簽核" type="object"
                            invisible="approval_state != 'pending'"/>
                    <field name="approval_state" widget="statusbar"
                           statusbar_visible="pending,approved,rejected"
                           readonly="1"
                           invisible="approval_state == 'not_required'"/>
                    <button name="action_escalate_to_eco" string="升級為 ECO"
                            type="object" class="btn-secondary"
                            groups="mfg_custom_base.group_engineering"
                            invisible="state == 'closed' or state == 'cancelled'"/>
                    <button name="action_close" string="結案"
                            type="object" class="btn-primary"
                            invisible="state == 'closed'"/>
                    <button name="action_reopen" string="重啟"
                            type="object" class="btn-secondary"
                            invisible="state != 'closed'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="已結案" bg_color="text-bg-success"
                            invisible="state != 'closed'"/>
                    <div class="oe_title">
                        <label for="subject"/>
                        <h1><field name="subject" placeholder="簡述問題..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="issue_type"/>
                            <field name="stage_id"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="reporter_id"/>
                            <field name="production_id"/>
                            <field name="product_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="現象描述" name="description">
                            <field name="description"/>
                        </page>
                        <page string="8D 流程" name="d8">
                            <group>
                                <field name="d1_team"/>
                                <field name="d2_problem"/>
                                <field name="d3_containment"/>
                                <field name="root_cause"/>
                                <field name="d5_corrective"/>
                                <field name="d7_prevent"/>
                            </group>
                        </page>
                        <page string="改善行動" name="actions">
                            <field name="action_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="owner_id" widget="many2one_avatar_user"/>
                                    <field name="deadline"/>
                                    <field name="state"/>
                                    <field name="done_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="關聯" name="links">
                            <group>
                                <field name="workorder_id"/>
                                <field name="workcenter_id"/>
                                <field name="lot_id"/>
                                <field name="quality_check_id"/>
                                <field name="task_id"/>
                                <field name="eco_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="mfg_issue_view_kanban" model="ir.ui.view">
        <field name="name">mfg_custom.issue.view.kanban</field>
        <field name="model">mfg_custom.issue</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" quick_create="false" class="o_kanban_small_column">
                <field name="priority"/>
                <field name="user_id"/>
                <field name="production_id"/>
                <field name="subject"/>
                <field name="name"/>
                <field name="issue_type"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_head">
                            <field name="priority" widget="priority"/>
                            <field name="name" class="ms-auto"/>
                        </div>
                        <div class="fw-bold">
                            <field name="subject"/>
                        </div>
                        <div>
                            <field name="issue_type"/>
                            <t t-if="record.eco_id.raw_value">
                                <span class="badge rounded-pill text-bg-info ms-2">ECO</span>
                            </t>
                        </div>
                        <div class="mt-2">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <t t-if="record.production_id.raw_value">
                                <span class="ms-2">
                                    <i class="fa fa-cog"/>
                                    <field name="production_id"/>
                                </span>
                            </t>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="mfg_issue_view_search" model="ir.ui.view">
        <field name="name">mfg_custom.issue.view.search</field>
        <field name="model">mfg_custom.issue</field>
        <field name="arch" type="xml">
            <search string="搜尋問題点">
                <field name="name"/>
                <field name="subject"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="user_id"/>
                <filter name="open" string="開立中" domain="[('state', 'in', ['open', 'analyzing', 'implementing'])]"/>
                <filter name="approval_pending" string="待簽核" domain="[('approval_state', '=', 'pending')]"/>
                <filter name="approval_approved" string="已核准" domain="[('approval_state', '=', 'approved')]"/>
                <filter name="closed" string="已結案" domain="[('state', '=', 'closed')]"/>
                <filter name="high_priority" string="高/緊急" domain="[('priority', 'in', ['2', '3'])]"/>
                <group>
                    <filter name="group_by_stage" string="依階段" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_by_type" string="依類型" context="{'group_by': 'issue_type'}"/>
                    <filter name="group_by_user" string="依負責人" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mfg_issue_action_kanban" model="ir.actions.act_window">
        <field name="name">問題点（看板）</field>
        <field name="res_model">mfg_custom.issue</field>
        <field name="view_mode">kanban,list,form</field>
                </record>

    <record id="mfg_issue_action_tree" model="ir.actions.act_window">
        <field name="name">問題点（清單）</field>
        <field name="res_model">mfg_custom.issue</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mfg_issue_kanban"
              name="問題点看板"
              parent="mfg_custom_base.menu_mfg_custom_root"
              sequence="10"
              action="mfg_issue_action_kanban"
              groups="mfg_custom_base.group_user"/>

    <menuitem id="menu_mfg_issue_tree"
              name="問題点清單"
              parent="mfg_custom_base.menu_mfg_custom_root"
              sequence="11"
              action="mfg_issue_action_tree"
              groups="mfg_custom_base.group_user"/>

</odoo>
